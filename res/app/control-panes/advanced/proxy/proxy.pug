.widget-container.fluid-height.stf-proxy(ng-controller='ProxyCtrl')
  .heading
    stacked-icon(icon='fa-exchange', color='color-blue')
    span(translate) 设置代理
  .widget-content.padded
    form(name='proxyForm', ng-submit='setProxy()')
      .form-group
        label(translate) Proxy IP
        input.form-control.input-sm(type='text', ng-model='proxy.host', autocomplete='off', autocorrect='off', spellcheck='false', placeholder='{{"示例 192.168.1.100" | translate}}')
      .form-group
        label(translate) Port
        input.form-control.input-sm(type='number', min='1', max='65535', ng-model='proxy.port', placeholder='{{"示例 8888" | translate}}')
      div
        button(type='submit', ng-disabled='proxyBusy').btn.btn-sm.btn-primary-outline
          i.fa.fa-exchange
          span(translate) 设置代理
        button(type='button', ng-disabled='proxyBusy', ng-click='clearProxy()').btn.btn-sm.btn-danger-outline
          i.fa.fa-ban
          span(translate) 关闭代理
    p.text-muted.small(ng-if='proxyStatus')
      i.fa.fa-info-circle
      span(ng-bind='proxyStatus')
